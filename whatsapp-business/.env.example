# -------- Server --------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# -------- WhatsApp Cloud API --------
# Meta App credentials - https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=your_long_lived_access_token_here
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# Webhook verification (choose any random strings, match them in the Meta App console)
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_verify_token
# Used to validate X-Hub-Signature-256 on inbound webhooks. Get this from Meta App > Settings > Basic > App Secret
WHATSAPP_APP_SECRET=replace_with_app_secret

# -------- Database --------
DATABASE_URL=postgres://whatsapp:whatsapp@localhost:5432/whatsapp
PGPOOL_MAX=10

# -------- Reporting --------
REPORT_OUTPUT_DIR=./reports
# Cron expression for the weekly job. Default: Mondays 07:00 Riyadh time.
WEEKLY_REPORT_CRON=0 7 * * 1
REPORT_TIMEZONE=Asia/Riyadh

# -------- Rate limiting --------
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=300

# -------- Business --------
COMPANY_NAME_AR=شركة جبل عمر للتطوير
COMPANY_NAME_EN=Jabal Omar Development Company
VENDOR_PORTAL_URL=https://jabalomar.com.sa/en/vendors-portal/
