# -------- Server --------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# -------- WhatsApp Cloud API --------
# Meta App credentials - https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=your_long_lived_access_token_here
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# Webhook verification (choose any random strings, match them in the Meta App console)
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_verify_token
# Used to validate X-Hub-Signature-256 on inbound webhooks. Get this from Meta App > Settings > Basic > App Secret
WHATSAPP_APP_SECRET=replace_with_app_secret

# -------- Database --------
DATABASE_URL=postgres://whatsapp:whatsapp@localhost:5432/whatsapp
PGPOOL_MAX=10

# -------- Reporting --------
REPORT_OUTPUT_DIR=./reports
# Cron expression for the weekly job. Default: Mondays 07:00 Riyadh time.
WEEKLY_REPORT_CRON=0 7 * * 1
REPORT_TIMEZONE=Asia/Riyadh

# -------- Rate limiting --------
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=300

# -------- Business --------
COMPANY_NAME_AR=شركة جبل عمر للتطوير
COMPANY_NAME_EN=Jabal Omar Development Company
VENDOR_PORTAL_URL=https://jabalomar.com.sa/en/vendors-portal/

# -------- Auth (required in production) --------
# Generate a random 32-byte hex string:  openssl rand -hex 32
JWT_SECRET=replace_me_with_a_random_32byte_secret__________
JWT_TTL_SECONDS=28800
AUTH_COOKIE_NAME=jo_auth
# Set to true behind HTTPS
AUTH_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10
# Default password seeded for demo users; must change in prod.
SEED_DEFAULT_PASSWORD=changeme123

# -------- Outbound queue + 24h service window --------
OUTBOUND_QUEUE_POLL_MS=2000
OUTBOUND_QUEUE_BATCH_SIZE=10
OUTBOUND_MAX_ATTEMPTS=5
WHATSAPP_SERVICE_WINDOW_HOURS=24
# Name + language of an approved re-engagement template (leave blank to park messages instead).
WHATSAPP_DEFAULT_TEMPLATE_NAME=
WHATSAPP_DEFAULT_TEMPLATE_LANG=ar

# -------- CRM sync --------
# One of: mock | webhook | disabled
CRM_ADAPTER=mock
CRM_WEBHOOK_URL=
CRM_WEBHOOK_AUTH_HEADER=
CRM_RETRY_MAX=5

# -------- AI assist (Anthropic) --------
# Leave blank to run with the local heuristic fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_ASSIST_ENABLED=true

# -------- SLA breach notifier --------
# When enabled, breaches of first_response_due_at / resolution_due_at are
# POSTed once per (conversation, kind) to SLA_ALERTS_WEBHOOK_URL as a
# Slack-compatible {text: "..."} payload.
SLA_ALERTS_ENABLED=false
SLA_ALERTS_WEBHOOK_URL=
SLA_ALERTS_POLL_CRON=*/3 * * * *
